{
  "expo": {
    "name": "Underground",
    "slug": "underground-mobile",
    "scheme": "underground",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.underground.mobile"
    },
    "android": {
      "package": "com.underground.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#B026FF"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:3000/api/v1"
    }
  }
}
